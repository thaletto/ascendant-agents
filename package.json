{
  "name": "ascendant-agents",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ascendant": "node --experimental-strip-types skills/ascendant/tools/ascendant.ts",
    "init-person": "node --experimental-strip-types skills/ascendant/tools/ascendant.ts init-person",
    "check-transit": "node --experimental-strip-types skills/ascendant/tools/ascendant.ts transit",
    "test": "bun test",
    "build:skill": "node scripts/build-skill.mjs",
    "mcp:serve": "bun mcp-server/server.ts",
    "mcp:stdio": "bun mcp-server/stdio.ts",
    "typecheck": "tsc --project skills/ascendant/tsconfig.json --noEmit && tsc --project mcp-server/tsconfig.json --noEmit && tsc --project .opencode/tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt skills/ascendant/tools scripts mcp-server api .opencode/plugins *.json .oxlintrc.json .oxfmtrc.json skills/ascendant/tsconfig.json mcp-server/tsconfig.json .opencode/tsconfig.json",
    "format:check": "npm run format -- --check"
  },
  "dependencies": {
    "@effect/platform-node-shared": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "4.1.1",
    "astro-ascendant": "4.0.1",
    "axi-sdk-js": "0.1.11",
    "effect": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@toon-format/toon": "4.1.1"
  },
  "trustedDependencies": [
    "@swisseph/node",
    "msgpackr-extract"
  ]
}
